{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile, reading preferences, and bounded study progress lists.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "bn", "hi", "ar", "es", "fr", "zh", "ja", "de", "pt"],
          "maxLength": 10
        },
        "bilingualMode": {
          "type": "boolean"
        },
        "ageLevel": {
          "type": "string",
          "enum": ["explorer", "student", "mastery"],
          "maxLength": 20
        },
        "fontScale": {
          "type": "string",
          "enum": ["compact", "comfortable", "large"],
          "maxLength": 20
        },
        "readingTheme": {
          "type": "string",
          "enum": ["paper", "warm", "contrast"],
          "maxLength": 20
        },
        "bookmarkedIds": {
          "type": "array"
        },
        "masteredTopicIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "preferredLanguage",
        "bilingualMode",
        "ageLevel",
        "fontScale",
        "readingTheme",
        "bookmarkedIds",
        "masteredTopicIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Personal study note authored by a user for a specific subject store.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subjectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "storeId": {
          "type": "string",
          "enum": ["science", "arts", "commerce", "applied"],
          "maxLength": 20
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "subjectId",
        "subjectName",
        "storeId",
        "content",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores private user settings, language selection, reading comfort options, and study progress."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/StudyNote"
      },
      "description": "Stores personal study notes created by the owning learner."
    }
  }
}
