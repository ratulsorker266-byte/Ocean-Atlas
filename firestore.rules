rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidBoundedIdList(listVal) {
      return listVal is list
        && listVal.size() <= 200
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() >= 1 && listVal[0].size() <= 100));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'preferredLanguage',
          'bilingualMode',
          'ageLevel',
          'fontScale',
          'readingTheme',
          'bookmarkedIds',
          'masteredTopicIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'preferredLanguage',
          'bilingualMode',
          'ageLevel',
          'fontScale',
          'readingTheme',
          'bookmarkedIds',
          'masteredTopicIds',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.preferredLanguage is string
        && data.preferredLanguage in ['en', 'bn', 'hi', 'ar', 'es', 'fr', 'zh', 'ja', 'de', 'pt']
        && data.bilingualMode is bool
        && data.ageLevel is string
        && data.ageLevel in ['explorer', 'student', 'mastery']
        && data.fontScale is string
        && data.fontScale in ['compact', 'comfortable', 'large']
        && data.readingTheme is string
        && data.readingTheme in ['paper', 'warm', 'contrast']
        && isValidBoundedIdList(data.bookmarkedIds)
        && isValidBoundedIdList(data.masteredTopicIds)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyNote(data, userId, noteId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'subjectId',
          'subjectName',
          'storeId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'subjectId',
          'subjectName',
          'storeId',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == noteId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && data.subjectId is string
        && data.subjectId.size() >= 1
        && data.subjectId.size() <= 80
        && isValidId(data.subjectId)
        && data.subjectName is string
        && data.subjectName.size() >= 1
        && data.subjectName.size() <= 120
        && data.storeId is string
        && data.storeId in ['science', 'arts', 'commerce', 'applied']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'preferredLanguage',
          'bilingualMode',
          'ageLevel',
          'fontScale',
          'readingTheme',
          'bookmarkedIds',
          'masteredTopicIds',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isOwner(userId) && isEmailVerified();

      match /notes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isEmailVerified()
          && isValidStudyNote(incoming(), userId, noteId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && isEmailVerified()
          && isValidStudyNote(incoming(), userId, noteId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'subjectId',
            'subjectName',
            'storeId',
            'content',
            'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(noteId) && isOwner(userId) && isEmailVerified();
      }
    }
  }
}
